# RecapFlow Backend Environment Configuration

# OpenRouter AI Configuration
OPEN_ROUTER_API_KEY=your_openrouter_api_key_here
# Configurable fallback models chain (comma-separated, max 3 models prioritized)
OPENROUTER_MODELS=openrouter/free,google/gemma-4-26b-a4b-it:free,qwen/qwen3.8-27b:free
# Provider sorting strategy: throughput (fastest tokens/sec), latency, or price
OPENROUTER_SORT_BY=throughput
# Partitioning: 'none' sorts globally across all model endpoints; 'model' groups by model first
OPENROUTER_PARTITION=none
OPENROUTER_TIMEOUT=45.0
APP_SITE_URL=https://recapflow.com
APP_TITLE=RecapFlow

# Email Configuration (Gmail SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=recapflow@gmail.com
EMAIL_PASSWORD=your_app_password_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
